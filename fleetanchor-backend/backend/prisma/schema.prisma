// FleetAnchor Pro — Prisma Database Schema
// PostgreSQL with row-level multi-tenancy

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── MULTI-TENANT ROOT ────────────────────────────────────────────────────────
model Tenant {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  oemCompanies OemCompany[]

  @@map("tenants")
}

// ─── OEM COMPANIES (workshops that sell the platform) ─────────────────────────
model OemCompany {
  id           String       @id @default(uuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  name         String
  contactEmail String
  contactPhone String?
  address      String?
  logoUrl      String?
  planTier     PlanTier     @default(GROWTH)
  paystackSubCode String?
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  vendors      Vendor[]
  users        User[]

  @@map("oem_companies")
}

// ─── VENDORS (companies that bring fleets) ────────────────────────────────────
model Vendor {
  id            String        @id @default(uuid())
  oemId         String
  oem           OemCompany    @relation(fields: [oemId], references: [id])
  companyName   String
  contactEmail  String
  contactPhone  String?
  address       String?
  status        VendorStatus  @default(ACTIVE)
  suspendedAt   DateTime?
  suspendedBy   String?
  suspendReason String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  users         User[]
  vehicles      Vehicle[]
  subscriptions Subscription[]

  @@map("vendors")
}

// ─── USERS ────────────────────────────────────────────────────────────────────
model User {
  id              String     @id @default(uuid())
  oemId           String?
  oem             OemCompany? @relation(fields: [oemId], references: [id])
  vendorId        String?
  vendor          Vendor?    @relation(fields: [vendorId], references: [id])
  fullName        String
  email           String     @unique
  passwordHash    String
  role            UserRole
  totpSecret      String?
  totpEnabled     Boolean    @default(false)
  resetToken      String?
  resetTokenHash  String?
  resetExpires    DateTime?
  resetAttempts   Int        @default(0)
  lastResetAt     DateTime?
  active          Boolean    @default(true)
  lastLoginAt     DateTime?
  lastLoginIp     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  jobRequests     JobRequest[]
  auditLogs       AuditLog[]
  sentNotifications Notification[]

  @@map("users")
}

// ─── VEHICLES ─────────────────────────────────────────────────────────────────
model Vehicle {
  id           String        @id @default(uuid())
  vendorId     String
  vendor       Vendor        @relation(fields: [vendorId], references: [id])
  vin          String        @unique
  plateNumber  String
  engineNumber String?
  make         String
  model        String
  year         Int
  category     String?
  status       VehicleStatus @default(ACTIVE)
  registeredAt DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  jobRequests  JobRequest[]

  @@index([vin])
  @@index([plateNumber])
  @@map("vehicles")
}

// ─── JOB REQUESTS ─────────────────────────────────────────────────────────────
model JobRequest {
  id            String        @id @default(uuid())
  jobNumber     String        @unique
  vehicleId     String
  vehicle       Vehicle       @relation(fields: [vehicleId], references: [id])
  createdById   String
  createdBy     User          @relation(fields: [createdById], references: [id])
  category      RepairCategory
  description   String
  priority      Priority      @default(NORMAL)
  status        JobStatus     @default(SUBMITTED)
  bayNumber     String?
  technicianId  String?
  submittedAt   DateTime      @default(now())
  diagnosedAt   DateTime?
  estimateSentAt DateTime?
  approvedAt    DateTime?
  repairStartAt DateTime?
  completedAt   DateTime?
  paymentAt     DateTime?
  closedAt      DateTime?
  updatedAt     DateTime      @updatedAt
  timelines     JobTimeline[]
  estimates     Estimate[]
  invoices      Invoice[]
  notifications Notification[]

  @@index([jobNumber])
  @@map("job_requests")
}

// ─── JOB TIMELINE ─────────────────────────────────────────────────────────────
model JobTimeline {
  id          String     @id @default(uuid())
  jobId       String
  job         JobRequest @relation(fields: [jobId], references: [id])
  status      JobStatus
  note        String?
  actorId     String?
  actorName   String
  createdAt   DateTime   @default(now())

  @@map("job_timelines")
}

// ─── ESTIMATES ────────────────────────────────────────────────────────────────
model Estimate {
  id           String         @id @default(uuid())
  jobId        String
  job          JobRequest     @relation(fields: [jobId], references: [id])
  partsCost    Decimal        @db.Decimal(12, 2)
  labourCost   Decimal        @db.Decimal(12, 2)
  totalCost    Decimal        @db.Decimal(12, 2)
  notes        String?
  status       EstimateStatus @default(PENDING)
  queryNote    String?
  revision     Int            @default(1)
  sentAt       DateTime       @default(now())
  approvedAt   DateTime?
  rejectedAt   DateTime?

  @@map("estimates")
}

// ─── INVOICES ─────────────────────────────────────────────────────────────────
model Invoice {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique
  jobId           String
  job             JobRequest    @relation(fields: [jobId], references: [id])
  partsCost       Decimal       @db.Decimal(12, 2)
  labourCost      Decimal       @db.Decimal(12, 2)
  totalAmount     Decimal       @db.Decimal(12, 2)
  paymentConfirmed Boolean      @default(false)
  paystackRef     String?
  paystackTrxRef  String?
  issuedAt        DateTime      @default(now())
  paidAt          DateTime?
  pdfUrl          String?

  @@index([invoiceNumber])
  @@map("invoices")
}

// ─── SUBSCRIPTIONS ────────────────────────────────────────────────────────────
model Subscription {
  id             String       @id @default(uuid())
  vendorId       String
  vendor         Vendor       @relation(fields: [vendorId], references: [id])
  plan           PlanTier
  startDate      DateTime
  expiryDate     DateTime
  autoRenew      Boolean      @default(true)
  paystackSubCode String?
  paystackEmail  String?
  status         SubStatus    @default(ACTIVE)
  warningAt7Days Boolean      @default(false)
  warningAt3Days Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("subscriptions")
}

// ─── AUDIT LOGS (tamper-evident, hash-chained) ────────────────────────────────
model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  actorLabel  String
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  deviceFp    String?
  prevHash    String?
  recordHash  String
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}

// ─── NOTIFICATIONS ────────────────────────────────────────────────────────────
model Notification {
  id        String   @id @default(uuid())
  jobId     String?
  job       JobRequest? @relation(fields: [jobId], references: [id])
  sentById  String?
  sentBy    User?    @relation(fields: [sentById], references: [id])
  toEmail   String
  type      String
  subject   String
  body      String
  sentAt    DateTime @default(now())
  success   Boolean  @default(true)
  error     String?

  @@map("notifications")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────
enum PlanTier {
  GROWTH
  ENTERPRISE
  OEM_WHITE_LABEL
}

enum UserRole {
  SUPER_ADMIN
  OEM_ADMIN
  WORKSHOP_STAFF
  FLEET_MANAGER
  MAINTENANCE_SUPERVISOR
  FIELD_AGENT
}

enum VendorStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum VehicleStatus {
  ACTIVE
  IN_REPAIR
  DECOMMISSIONED
}

enum JobStatus {
  SUBMITTED
  DIAGNOSED
  ESTIMATE_SENT
  ESTIMATE_APPROVED
  ESTIMATE_QUERIED
  REPAIR_STARTED
  REPAIR_COMPLETE
  AWAITING_PAYMENT
  CLOSED
}

enum RepairCategory {
  ENGINE
  BRAKES
  TRANSMISSION
  ELECTRICAL
  CLIMATE_CONTROL
  TYRES_WHEELS
  SUSPENSION
  BODY_FRAME
  FUEL_SYSTEM
  OTHER
}

enum Priority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum EstimateStatus {
  PENDING
  APPROVED
  QUERIED
  REVISED
  REJECTED
}

enum SubStatus {
  ACTIVE
  EXPIRING
  EXPIRED
  SUSPENDED
}
