# FleetAnchor Pro API — copy to .env for local work; set the same keys in Render / Railway.
# Never commit real values.

# ── Required ──────────────────────────────────────────────────────────────────
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/fleetanchor
# 32+ random characters each, and different. Generate: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=
# The web app's address — the only site allowed to call the API from a browser
FRONTEND_URL=https://anchor-fleet-pro.vercel.app

# ── Optional ──────────────────────────────────────────────────────────────────
# Extra web addresses allowed to call the API, comma-separated
CORS_ORIGINS=
PORT=5000
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AUTH_RATE_LIMIT_MAX=10
RESET_RATE_LIMIT_MAX=3

# Payments (Paystack)
PAYSTACK_SECRET_KEY=

# Email — SendGrid, or any SMTP server
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
EMAIL_FROM_NAME=FleetAnchor Pro
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Weekly Google Drive backup
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=
BACKUP_NOTIFY_EMAIL=

# ── Only when running `npm run seed` on an empty database, then remove ────────
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
